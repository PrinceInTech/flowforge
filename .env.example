# ===== Server =====
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# ===== Database =====
DATABASE_URL=postgres://flowforge:flowforge@localhost:5432/flowforge
DB_SSL=false

# ===== Redis =====
REDIS_URL=redis://localhost:6379

# ===== Auth =====
# Use long random values in production. `openssl rand -hex 64`
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=604800

# ===== CORS =====
CORS_ORIGIN=http://localhost:5173

# ===== URLs =====
WEBHOOK_BASE_URL=http://localhost:3000
PUBLIC_WEB_URL=http://localhost:5173

# ===== Rate limiting =====
# Requests per minute
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_LOGIN=10
RATE_LIMIT_MAX_SIGNUP=5
RATE_LIMIT_MAX_WEBHOOK=60
RATE_LIMIT_MAX_API_KEY=120

# ===== Worker =====
WORKER_CONCURRENCY=8
STEP_LEASE_SECONDS=120
SCHEDULER_INTERVAL_MS=5000
RECONCILER_INTERVAL_MS=15000
OUTBOX_RELAY_INTERVAL_MS=1000

# ===== Frontend =====
VITE_API_URL=http://localhost:3000
# Prefill the demo credentials on the login page. Set to true only for demo
# deployments; production builds should leave this unset/false.
VITE_DEMO_CREDENTIALS=false