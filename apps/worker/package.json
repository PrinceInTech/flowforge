{
  "name": "@flowforge/worker",
  "version": "1.0.0",
  "private": true,
  "description": "FlowForge background worker (outbox relay, run consumers, reconciler)",
  "license": "MIT",
  "scripts": {
    "dev": "ts-node src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "echo \"Worker unit tests are in packages/engine\" && exit 0"
  },
  "dependencies": {
    "@flowforge/engine": "workspace:*",
    "@flowforge/shared": "workspace:*",
    "ioredis": "^5.4.1",
    "pg": "^8.11.5",
    "prom-client": "^15.1.3"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/pg": "^8.11.5",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}